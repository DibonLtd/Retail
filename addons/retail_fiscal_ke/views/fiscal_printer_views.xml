<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiscal_printer_form" model="ir.ui.view">
        <field name="name">fiscal.printer.form</field>
        <field name="model">fiscal.printer</field>
        <field name="arch" type="xml">
            <form string="Fiscal Printer">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Westgate Till 3 ESD"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="ip_address"/>
                            <field name="port"/>
                            <field name="address" readonly="1"/>
                        </group>
                        <group>
                            <field name="response_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fiscal_printer_list" model="ir.ui.view">
        <field name="name">fiscal.printer.list</field>
        <field name="model">fiscal.printer</field>
        <field name="arch" type="xml">
            <list string="Fiscal Printers">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="address"/>
                <field name="response_type"/>
            </list>
        </field>
    </record>

    <record id="action_fiscal_printer" model="ir.actions.act_window">
        <field name="name">Fiscal Printers</field>
        <field name="res_model">fiscal.printer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
