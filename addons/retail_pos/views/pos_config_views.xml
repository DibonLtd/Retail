<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_retail" model="ir.ui.view">
        <field name="name">pos.config.form.retail</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Tano Retail">
                    <field name="retail_block_zero_qty"/>
                    <field name="retail_return_window_days"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
