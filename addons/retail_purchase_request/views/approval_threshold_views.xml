<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_retail_approval_threshold_list" model="ir.ui.view">
        <field name="name">retail.approval.threshold.list</field>
        <field name="model">retail.approval.threshold</field>
        <field name="arch" type="xml">
            <list string="Approval Thresholds" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="amount_from"/>
                <field name="group_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_retail_approval_threshold" model="ir.actions.act_window">
        <field name="name">Approval Thresholds</field>
        <field name="res_model">retail.approval.threshold</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define an approval threshold</p>
            <p>An order reaching the stated amount requires approval from the named group.</p>
        </field>
    </record>
</odoo>
