<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_method_form_mpesa" model="ir.ui.view">
        <field name="name">pos.payment.method.form.mpesa</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="retail_mpesa_config_id"/>
                <field name="retail_mpesa_allow_stk"
                       invisible="not retail_mpesa_config_id"/>
            </xpath>
        </field>
    </record>
</odoo>
