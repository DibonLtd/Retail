<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="rule_purchase_request_own" model="ir.rule">
        <field name="name">Purchase requests: own records</field>
        <field name="model_id" ref="model_retail_purchase_request"/>
        <field name="domain_force">[('requestor_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="rule_purchase_request_procurement_all" model="ir.rule">
        <field name="name">Purchase requests: procurement and finance see all</field>
        <field name="model_id" ref="model_retail_purchase_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('retail_base.group_procurement_manager')), (4, ref('retail_base.group_finance_officer'))]"/>
    </record>
</odoo>
