<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
      Seeded from the US-PRQ-03 acceptance criteria: the Procurement Manager
      approves every order, and the CFO is additionally required above KES 1M.

      Note: the US-PRQ-03 narrative instead states that CFO approval applies
      above KES 500,000, contradicting its own acceptance criteria. Because
      these bands are data, correcting them is a configuration change: add
      or edit a threshold record rather than changing code.
    -->
    <record id="threshold_procurement_all" model="retail.approval.threshold">
        <field name="name">Procurement Manager (all orders)</field>
        <field name="sequence">10</field>
        <field name="amount_from">0.0</field>
        <field name="group_id" ref="retail_base.group_procurement_manager"/>
        <field name="company_id" eval="False"/>
    </record>

    <record id="threshold_cfo_above_one_million" model="retail.approval.threshold">
        <field name="name">CFO (above KES 1,000,000)</field>
        <field name="sequence">30</field>
        <field name="amount_from">1000000.0</field>
        <field name="group_id" ref="retail_base.group_purchase_cfo"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
