<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_fiscal" model="ir.ui.view">
        <field name="name">pos.config.form.fiscal.ke</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Fiscal Device">
                    <field name="retail_fiscal_printer_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_company_form_fiscal" model="ir.ui.view">
        <field name="name">res.company.form.fiscal.ke</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="retail_fiscal_enabled"/>
                <field name="retail_fiscal_printer_id"
                       invisible="not retail_fiscal_enabled"/>
                <field name="retail_exemption_hs_code"
                       invisible="not retail_fiscal_enabled"/>
            </xpath>
        </field>
    </record>
</odoo>
